QWidget {
    font-family: "Microsoft YaHei UI";
    font-size: 13px;
    color: #1f2937;
}

QMainWindow, QDialog, QWidget#pageRoot {
    background: #f4f6f8;
}

QFrame#sidebar {
    background: #172033;
    border: none;
}

QLabel#brandTitle {
    color: white;
    font-size: 20px;
    font-weight: 600;
    padding: 20px 14px 12px 14px;
}

QLabel#brandSubtitle {
    color: #9aa7bd;
    padding: 0 14px 14px 14px;
}

QPushButton[nav="true"] {
    color: #c7d0df;
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 10px 14px;
    text-align: left;
    margin: 1px 8px;
}

QPushButton[nav="true"]:hover {
    background: #253149;
    color: white;
}

QPushButton[nav="true"]:checked {
    background: #2563eb;
    color: white;
    font-weight: 600;
}

QFrame#topBar, QFrame#panel, QFrame#metricCard {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 7px;
}

QLabel#pageTitle {
    font-size: 20px;
    font-weight: 600;
}

QLabel#metricValue {
    font-size: 26px;
    font-weight: 600;
    color: #111827;
}

QLabel#metricLabel, QLabel#mutedText {
    color: #6b7280;
}

QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background: white;
    border: 1px solid #d1d5db;
    border-radius: 5px;
    padding: 6px 8px;
    min-height: 20px;
    selection-background-color: #2563eb;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus,
QSpinBox:focus, QTextEdit:focus {
    border-color: #2563eb;
}

QPushButton {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 7px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background: #f8fafc;
    border-color: #94a3b8;
}

QPushButton[primary="true"] {
    background: #2563eb;
    border-color: #2563eb;
    color: white;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background: #1d4ed8;
}

QPushButton[danger="true"] {
    color: #b91c1c;
    border-color: #fecaca;
    background: #fff7f7;
}

QPushButton:disabled {
    color: #9ca3af;
    background: #f3f4f6;
    border-color: #e5e7eb;
}

QTableView, QTableWidget {
    background: white;
    alternate-background-color: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 5px;
    gridline-color: #eef2f7;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

QHeaderView::section {
    background: #eef2f7;
    color: #334155;
    border: none;
    border-right: 1px solid white;
    border-bottom: 1px solid #dbe1e8;
    padding: 8px;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    background: white;
}

QTabBar::tab {
    background: #eef2f7;
    padding: 8px 18px;
}

QTabBar::tab:selected {
    background: white;
    color: #1d4ed8;
    font-weight: 600;
}

QToolTip {
    background: #111827;
    color: white;
    border: none;
    padding: 5px;
}

